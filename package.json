{
  "name": "mki",
  "version": "0.1.0",
  "private": true,
  "description": "MKI — painel pessoal da vida (PWA)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/bootstrap.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "dbmate --migrations-dir db/migrations up",
    "bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/bootstrap.ts",
    "icons": "node scripts/make-icons.mjs",
    "create-user": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/create-user.ts",
    "check": "tsc --noEmit && node scripts/check-server-links.mjs && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@mantine/notifications": "^9.8.0",
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@tabler/icons-react": "^3.51.0",
    "fast-xml-parser": "^5.12.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
