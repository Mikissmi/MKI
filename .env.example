# Neon (Postgres) — string de conexão (nunca vai para o navegador)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Segredo para assinar/derivar valores de sessão — gere com: openssl rand -base64 48
SESSION_SECRET=troque-por-um-valor-longo-e-aleatorio
# Entra na etapa 3 (Assistente de IA)
# GEMINI_API_KEY=

# Usuário definitivo: criado/atualizado automaticamente a cada deploy (script vercel-build).
# Trocou a senha aqui e fez novo deploy -> a senha do app muda e as sessões antigas caem.
MKI_ADMIN_USER=seu_usuario
MKI_ADMIN_PASSWORD=uma-senha-longa-com-10-ou-mais-caracteres
